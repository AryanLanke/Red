# --- Secrets: never commit ---
.env
.env.*
!.env.example
credentials.json
token.json
google-token.json
google-client.json
client_secret*.json
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Models and binaries (downloaded at runtime, never committed) ---
models/
bin/
*.gguf
*.onnx
*.tflite
*.bin
*.safetensors
*.pt
*.exe
*.dll

# --- Audio ---
*.wav
# Synthetic Piper clips for the voice-match tests (no one's real voice).
!tests/fixtures/voice/*.wav
*.mp3
*.flac
*.ogg
*.m4a

# --- Logs and command history ---
logs/
*.log

# --- What Red remembers about you (RED_HOME\memory): never commit ---
memory/
personality.txt
# Sign-in tokens and app passwords (DPAPI-encrypted, RED_HOME\config\secrets)
secrets/
*.secret

# --- Node (scripts/avatar_render) ---
node_modules/

# --- Editors and OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
