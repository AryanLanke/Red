# Copy this file to %RED_HOME%\config\.env and fill in your values.
# Never commit the real .env file.
#
# RED_HOME (where Red keeps models, caches, logs, and config) is set as an
# environment variable, not here, because this file lives inside RED_HOME.
# Default: %LOCALAPPDATA%\Red

# Which local backend to use: auto (Ollama, then llama.cpp), ollama, or llama.cpp.
RED_LLM_BACKEND=auto

# Your own OpenAI-compatible server (LM Studio, etc.). Overrides RED_LLM_BACKEND.
RED_LLM_URL=

# Model: qwen2.5-7b-instruct-q4_k_m (6 GB+ VRAM) or qwen2.5-3b-instruct-q4_k_m
RED_LLM_MODEL=qwen2.5-7b-instruct-q4_k_m

# How long the model stays in GPU memory after the last command (e.g. 5m, 30m, 0).
RED_LLM_KEEP_ALIVE=5m

# GPU build for the llama.cpp backend only: auto, cuda, vulkan, or cpu.
RED_LLM_GPU=auto

# Optional: GitHub token for the repo sync check (read-only scope is enough).
GITHUB_TOKEN=
