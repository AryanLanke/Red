# Copy this file to %RED_HOME%\config\.env and fill in your values.
# Never commit the real .env file.
#
# RED_HOME (where Red keeps models, caches, logs, and config) is set as an
# environment variable, not here, because this file lives inside RED_HOME.
# Default: %LOCALAPPDATA%\Red

# Which local backend to use: auto (Ollama, then llama.cpp), ollama, or llama.cpp.
RED_LLM_BACKEND=auto

# Your own OpenAI-compatible server (LM Studio, etc.). Overrides RED_LLM_BACKEND.
RED_LLM_URL=

# Model. python -m red setup picks one for your PC:
#   qwen3.5-4b   4 to 8 GB GPU (the default)
#   qwen3.5-9b   8 GB+ GPU
#   qwen2.5-3b-instruct-q4_k_m   no GPU (fastest on a CPU)
# Also: qwen3.5-2b, qwen2.5-7b-instruct-q4_k_m (the old default).
RED_LLM_MODEL=qwen3.5-4b

# How long the model stays in GPU memory after the last command (e.g. 5m, 30m, 0).
RED_LLM_KEEP_ALIVE=5m

# GPU build for the llama.cpp backend only: auto, cuda, vulkan, or cpu.
RED_LLM_GPU=auto

# Optional: GitHub token for the repo sync check (read-only scope is enough).
GITHUB_TOKEN=

# --- Voice ---

# Global shortcut that makes Red listen, for example Ctrl+Alt+R. "off" turns it off.
RED_HOTKEY=Ctrl+Alt+R

# Wake phrase: hey_red. "off" means the hotkey only. A path to a custom .onnx
# wake word model also works.
RED_WAKEWORD=hey_red

# How sure the wake word detector must be (0 to 1). Lower is more sensitive.
RED_WAKEWORD_THRESHOLD=0.5

# Answer only your voice: on or off. Run python -m red voice-setup first; it
# records "Hey Red" 10 times and saves your voice profile (numbers, no audio).
# With it on, Red stays silent when someone else says "Hey Red"; the hotkey
# always works. Off until you've tried it with another person speaking.
RED_VOICE_MATCH=off
# How alike the voice must be (0 to 1). Empty: the one voice-setup worked out
# for you. Raise it if others get in; lower it if Red ignores you.
RED_VOICE_MATCH_THRESHOLD=

# Speech to text: Whisper model and device (auto, cuda, or cpu).
# cpu is the default because Whisper and the language model don't fit together on a 6 GB GPU.
# On the CPU, base.en is about 3 times faster than small (0.4 s against 1.3 s for a
# short command) and was as accurate on Red's commands; small copes better with
# strong accents and other languages.
RED_WHISPER_MODEL=small
RED_WHISPER_DEVICE=cpu

# Text to speech: Kokoro (default, natural) or Piper (fallback/fast).
RED_TTS=kokoro
# Voice name for Kokoro (e.g. af_heart, af_bella, am_adam, am_michael, bf_emma, bm_george).
RED_VOICE=af_heart
# Voice speed (0.7 to 1.5, default 1.0).
RED_VOICE_SPEED=1.0
# Piper voice used as fallback if Kokoro files are missing or RED_TTS=piper.
RED_PIPER_VOICE=en_US-lessac-medium

# Microphone: a device number or part of its name. Empty means the Windows default.
RED_MIC_DEVICE=

# Seconds of silence that mean you've finished talking (0.3 to 5). Raise it
# if Red cuts you off when you pause; lower it if Red waits too long.
RED_END_SILENCE=1.5

# A shorter pause that's enough when what you said sounds finished ("open
# Edge"). After "and", "um" or a comma Red still waits RED_END_SILENCE.
# 0 to 5 seconds; 0 turns it off.
RED_QUICK_END_SILENCE=0.5

# Whisper starts writing down what you said after this much quiet, while the
# pause goes on, so the text is ready when the pause ends. 0 to 1 second; 0 turns it off.
RED_SPECULATE_AFTER=0.15

# Longest command, in seconds (3 to 120).
RED_MAX_COMMAND_SECONDS=20

# After chat, an answer (Red asks "Anything more you want to know about it?"),
# a reply that asks you something, or a failure, Red keeps listening this many
# seconds (0 to 30). After an action it goes quiet. Say "no" or "that's all"
# and it stops. 0 turns it off.
RED_FOLLOW_UP_SECONDS=7

# What Red shows while it works: companion (a character peeking over the bottom
# edge of the screen; the glow if its pictures aren't installed), glow (around
# the screen edges), card (a small card in the bottom-right corner), notify
# (Windows notifications), or off.
RED_OVERLAY=companion

# Which companion peeks over the edge: red, remy, asha, or the id of one you
# added with scripts\avatar_render\add.py. Empty: the last one picked from the
# companion's right-click menu (Red at first).
RED_COMPANION=

# How big the companion is: small, medium or large.
RED_COMPANION_SIZE=medium

# How often Red speaks without being asked: quiet (only answers), friendly
# (says hello at the start of your day and when you're back after 30+ minutes
# away), chatty (hellos plus a one-liner at most once an hour), or companion
# (chatty, plus the companion looks around, grumbles when ignored, at most once
# an hour, and a music lover puts on a song of its own at most once every 2
# hours: it says so first, and "stop" stops it). Never meetings, mail, to-dos
# or news; and never during a game, a full-screen app or a call. Leave this
# out and each companion uses the level in its own pack (Red: companion).
# RED_CHATTINESS=friendly

# Opens and hides the chat window, where you can type to Red and see code and
# drafts (or say "open chat"). off turns the hotkey off.
RED_CHAT_HOTKEY=<ctrl>+<alt>+<space>

# --- Web ---

# Search engine for "search the web for ...": google, bing, or duckduckgo.
RED_SEARCH_ENGINE=google

# Answers that also check web pages, not just Wikipedia: on or off.
# `python -m red setup` installs SearXNG (https://docs.searxng.org/) under
# RED_HOME\searxng, and Red runs it on this PC only while Red runs.
# Privacy: the words of your question go to the search engines SearXNG asks,
# and Red downloads the top three pages, which see your internet address.
# Nothing else is sent. Off: Wikipedia only. See README "Privacy and safety".
RED_WEB_SEARCH=on

# Optional: your own SearXNG on this PC instead of Red's, with JSON output on.
# Only addresses on this PC are accepted.
# RED_SEARCH_URL=http://127.0.0.1:8888

# The browser Red opens pages, searches and YouTube in: chrome, edge, firefox,
# or default (the Windows default browser). If it isn't installed, Red uses the
# Windows default. Say "open YouTube in Edge" to pick one for a single page.
RED_BROWSER=chrome

