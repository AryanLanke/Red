# Copy this file to %RED_HOME%\config\.env and fill in your values.
# Never commit the real .env file.

# Where Red keeps models, caches, logs, and config.
# Blank means %LOCALAPPDATA%\Red.
RED_HOME=

# LLM server. Blank means Red starts its own bundled llama-server.
# To use an existing server instead, e.g. Ollama: http://127.0.0.1:11434/v1
RED_LLM_URL=

# Model to load (bundled server) or request (external server).
RED_LLM_MODEL=qwen2.5-7b-instruct-q4_k_m

# GPU backend for the bundled server: auto, cuda, vulkan, or cpu.
RED_LLM_GPU=auto

# Optional: GitHub token for the repo sync check (read-only scope is enough).
GITHUB_TOKEN=
